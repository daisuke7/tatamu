#use std::sync::OnceLock
fn re(pat &'static str, cell &'static OnceLock<regex::Regex>) &'static regex::Regex {
cell.get_or_init(|| regex::Regex::new(pat).unwrap())
}
fn strip_lits(line &str) String {
static RE: OnceLock<regex::Regex> = OnceLock::new()
re(r####"b?r#"(?s).*?"#|b?r"[^"]*"|b?"(\\.|[^"\\])*"|'(\\.|[^'\\])'"####, &RE).replace_all(line, "\"\"").to_string()
}
fn count_of(s &str, chars &[char]) usize {
s.chars().filter(|c| chars.contains(c)).count()
}
fn ends_terminated(bare &str) bool {
bare.ends_with(';') || bare.ends_with('{') || bare.ends_with('}') || bare.ends_with(',') || bare.starts_with("#[")
}
fn in_open_string(buf &str) bool {
blanked := blank_strings(buf)
blanked.chars().filter(|c| *c == '"').count() % 2 == 1
}
fn looks_like_literal_body(next &str) bool {
static RE_FIELD: OnceLock<regex::Regex> = OnceLock::new()
re(r"^(\.\.|\w+\s*:[^:]|\w+\s*,\s*$|\w+\s*$)", &RE_FIELD).is_match(next.trim())
}
fn join_wrapped(input &[String]) Vec<String> {
mut out := Vec::new()
mut buf := String::new()
mut lit_depth := 0i64
for (i, line) in input.iter().enumerate() {
open_string := !buf.is_empty() && in_open_string(&buf)
t := if open_string {line.as_str()} else {line.trim()}
if t.trim().is_empty() && !open_string {continue}
if !open_string && t.starts_with("//") {
if !buf.is_empty() {out.push(strip_trailing_commas(&std::mem::take(&mut buf)))}
continue
}
if buf.is_empty() {buf = t.trim().to_string()} else if open_string {
// multi-line string literal: fold it into one line with Rust semantics
if buf.ends_with('\\') {
buf.pop()
buf.push_str(t.trim_start())
} else {
buf.push_str("\\n")
buf.push_str(t)
}
} else {
glue := if buf.ends_with('(') || t.starts_with(')') || t.starts_with('.') || t.starts_with(']') {""} else {" "}
buf.push_str(glue)
buf.push_str(t)
}
bare := strip_lits(&buf)
line_bare := strip_lits(t.trim())
next := input.get(i + 1).map(|l| l.trim()).unwrap_or("")
if lit_depth > 0 {
lit_depth += count_of(&line_bare, &['{']) as i64 - count_of(&line_bare, &['}']) as i64
} else if bare.ends_with('{') && looks_like_literal_body(next) && !bare.trim_start().starts_with("match ") {
lit_depth = 1
}
if lit_depth > 0 {continue}
depth := count_of(&bare, &['(', '[']) as i64 - count_of(&bare, &[')', ']']) as i64
terminated := ends_terminated(&bare) || next.starts_with('}') || next.is_empty()
if depth <= 0 && terminated && !in_open_string(&buf) {
out.push(strip_trailing_commas(&std::mem::take(&mut buf)))
}
}
if !buf.is_empty() {out.push(strip_trailing_commas(&buf))}
out
}
fn strip_trailing_commas(line &str) String {
blanked := blank_strings(line)
mut keep: Vec<bool> := vec![true; line.len()]
bytes := blanked.as_bytes()
mut i := 0
while i < bytes.len() {
if bytes[i] == b',' {
mut j := i + 1
while j < bytes.len() && (bytes[j] == b' ') {j += 1}
if j < bytes.len() && (bytes[j] == b')' || bytes[j] == b']' || bytes[j] == b'>') {
for k in i..j {keep[k] = false}
}
}
i += 1
}
line.char_indices().filter(|(idx, _)| *keep.get(*idx).unwrap_or(&true)).map(|(_, c)| c).collect()
}
fn convert_sig(t &str) String {
start := match t.find("fn ") {
Some(s) if t[..s].chars().all(|c| c.is_alphanumeric() || c == ' ' || c == '_' || c == '"') => s,
_ => return t.to_string(),
}
rest := &t[start + 3..]
name_end := rest.find(|c: char| !c.is_alphanumeric() && c != '_').unwrap_or(rest.len())
name := &rest[..name_end]
mut i := start + 3 + name_end
bytes: Vec<char> := t.chars().collect()
mut generics := String::new()
if bytes.get(i) == Some(&'<') {
mut depth := 0i64
g0 := i
while i < bytes.len() {
match bytes[i] {
'<' => depth += 1,
'>' => {
depth -= 1
if depth == 0 {i += 1; break}
}
_ => {}
}
i += 1
}
generics = bytes[g0..i].iter().collect()
}
while bytes.get(i) == Some(&' ') {i += 1}
if bytes.get(i) != Some(&'(') {return t.to_string()}
mut depth := 0i64
p0 := i
while i < bytes.len() {
match bytes[i] {
'(' => depth += 1,
')' => {
depth -= 1
if depth == 0 {i += 1; break}
}
_ => {}
}
i += 1
}
params_raw: String := bytes[p0 + 1..i - 1].iter().collect()
mut after: String := bytes[i..].iter().collect()
after = after.trim_start().to_string()
if after.starts_with("->") {
after = after[2..].trim_start().to_string()
}
static PARAM_RE: OnceLock<regex::Regex> = OnceLock::new()
param_re := re(r"^(mut\s+)?(\w+):\s*", &PARAM_RE)
mut parts := Vec::new()
mut d := 0i64
mut cur := String::new()
mut prev := ' '
for ch in params_raw.chars() {
match ch {
'<' | '(' | '[' => d += 1,
')' | ']' => d -= 1,
'>' if prev != '-' => d -= 1,
_ => {}
}
if ch == ',' && d == 0 {parts.push(std::mem::take(&mut cur))} else {cur.push(ch)}
prev = ch
}
if !cur.trim().is_empty() {parts.push(cur)}
converted: Vec<String> := parts.iter().map(|p| param_re.replace(p.trim(), "$1$2 ").to_string()).collect()
mut out := t[..start].to_string()
out.push_str(&format!("fn {name}{generics}({})", converted.join(", ")))
if !after.is_empty() {
out.push(' ')
out.push_str(&after)
}
out
}
fn convert_line(raw &str, siblings &[String], in_fields bool) String {
static LETMUT: OnceLock<regex::Regex> = OnceLock::new()
static LETPLAIN: OnceLock<regex::Regex> = OnceLock::new()
static CONSTRE: OnceLock<regex::Regex> = OnceLock::new()
static FIELDRE: OnceLock<regex::Regex> = OnceLock::new()
static PUBRE: OnceLock<regex::Regex> = OnceLock::new()
mut t := raw.trim().to_string()
t = re(r"^pub(\([^)]*\))?\s+", &PUBRE).replace(&t, "").to_string()
t = re(r"^let\s+mut\s+(\w+)(:\s*[^=]+?)?\s*=\s*", &LETMUT).replace(&t, |c: &regex::Captures| {
ty := c.get(2).map(|m| m.as_str().trim_end().to_string()).unwrap_or_default()
format!("mut {}{} := ", &c[1], ty)
}).to_string()
t = re(r"^let\s+(\([^)]*\)|\w+)(:\s*[^=]+?)?\s*=\s*([^=])", &LETPLAIN).replace(&t, |c: &regex::Captures| {
ty := c.get(2).map(|m| m.as_str().trim_end().to_string()).unwrap_or_default()
format!("{}{} := {}", &c[1], ty, &c[3])
}).to_string()
if t.contains("fn ") {t = convert_sig(&t)}
t = re(r"^const\s+(\w+):\s*", &CONSTRE).replace(&t, "const $1 ").to_string()
if in_fields {
t = re(r"^(pub\s+)?(\w+):\s+", &FIELDRE).replace(&t, "$2 ").to_string()
}
if !siblings.is_empty() {
mut stripped := String::new()
mut rest := t.as_str()
loop {
found := siblings.iter().filter_map(|s| rest.find(&format!("{s}::")).map(|i| (i, s.len() + 2))).min()
match found {
Some((i, len)) => {
before := &rest[..i]
if strip_lits(before).len() == before.len() || !before.contains('"') {
stripped.push_str(before)
rest = &rest[i + len..]
} else {
stripped.push_str(&rest[..i + len])
rest = &rest[i + len..]
}
}
None => {
stripped.push_str(rest)
break
}
}
}
t = stripped
}
if t.ends_with(';') {t.pop();}
t.trim_end().to_string()
}
