#dep tiktoken-rs 0
#dep serde 1 features=derive
#dep serde_json 1
fn main() R<()> {
args: Vec<String> := env::args().collect()
dir := args.get(1).map(String::as_str).unwrap_or(".")
fmt := if args.iter().any(|a| a == "--json") {Format::Json {pretty: true}} else {Format::Table}
bpe := tiktoken_rs::o200k_base()?
stats := scan_dir(dir, &bpe)?
if stats.is_empty() {return Err(format!("no .ttm files in {dir}").into())}
print!("{}", render(&stats, &fmt)?)
Ok(())
}
