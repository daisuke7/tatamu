#crate staticlib,cdylib,rlib
#[no_mangle]
extern "C" fn md_alloc(len usize) *mut u8 {
mut buf := Vec::with_capacity(len)
ptr := buf.as_mut_ptr()
mem::forget(buf)
ptr
}
#[no_mangle]
extern "C" fn md_free(ptr *mut u8, cap usize) {
unsafe {drop(Vec::from_raw_parts(ptr, 0, cap))}
}
#[no_mangle]
extern "C" fn md_to_html(ptr *const u8, len usize, out_len *mut usize) *mut u8 {
src := unsafe {std::str::from_utf8_unchecked(std::slice::from_raw_parts(ptr, len))}
mut out := to_html(src).into_bytes()
out.shrink_to_fit()
unsafe {*out_len = out.len()}
p := out.as_mut_ptr()
mem::forget(out)
p
}
