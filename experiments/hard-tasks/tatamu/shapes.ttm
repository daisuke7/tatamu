enum Shape {Circle(f64), Rect(f64, f64)}
impl Shape {
fn area(&self) f64 {
match self {
Shape::Circle(r) => PI * r * r,
Shape::Rect(w, h) => w * h,
}
}
}
fn main() {
shapes := vec![Shape::Circle(1.0), Shape::Rect(2.0, 3.0), Shape::Circle(0.5)]
total: f64 := shapes.iter().map(|s| s.area()).sum()
println!("{total:.2}")
}
